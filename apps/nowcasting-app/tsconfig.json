{
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "coverage",
    "temp",
    "cypress-examples",
    ".yarn",
    ".bit"
  ],
  "extends": "@openclimatefix/nowcasting-tsconfig/nextjs.json",
  "compilerOptions": {
    "rootDir": "",
    "outDir": "dist",
    "incremental": true,
    "strict": true,
    "target": "ES6",
    "downlevelIteration": true
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts"]
}
