node_modules
.turbo
build/
dist/
.next/
.env
# Parked clutter: dead spikes, stale artefacts and one-off outputs moved out of the
# app and repo roots so TypeScript, jest, next and eslint stop seeing them. Nothing
# here is referenced by the app. Safe to delete once nobody misses it.
.attic/

# Raw user-research notes and the matrix derived from them. Named customers,
# commercial detail and meeting minutes — kept on disk for design rationale,
# deliberately never committed.
docs/feedback/

# Working notes for the adaptive-eu-ui epic (phase/track notes, contracts, spikes, mocks).
# Local design scratch, not repo documentation: kept on disk, never committed.
# Only the PR templates under docs/ are tracked.
docs/*
!docs/PULL_REQUEST_TEMPLATE/

# TypeScript incremental build state. Machine-local, rewritten by every typecheck,
# and a permanent source of noise in `git status`.
*.tsbuildinfo
